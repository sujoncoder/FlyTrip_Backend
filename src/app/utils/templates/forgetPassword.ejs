<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>FlyTrip - Password Reset</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f4f8fb;
            margin: 0;
            padding: 0;
            color: #333;
        }

        .container {
            max-width: 550px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1e90ff, #00c6ff);
            padding: 25px;
            text-align: center;
            color: #fff;
        }

        .header h1 {
            margin: 0;
            font-size: 26px;
        }

        .content {
            padding: 30px;
            line-height: 1.6;
            text-align: center;
            /* Centering the button */
        }

        .content p {
            font-size: 15px;
            color: #555;
        }

        .btn {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 24px;
            background: #1e90ff;
            color: #fff !important;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: background 0.3s ease;
        }

        .btn:hover {
            background: #0077cc;
        }

        .footer {
            background-color: #f1f5f9;
            text-align: center;
            padding: 15px;
            font-size: 12px;
            color: #777;
        }

        .highlight {
            color: #1e90ff;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header">
            <h1>FlyTrip</h1>
            <p>Your journey starts here ✈️</p>
        </div>

        <!-- CONTENT -->
        <div class="content">
            <p>Hello <strong>
                    <%= name %>
                </strong>,</p>
            <p>
                We received a request to reset your password for your <span class="highlight">FlyTrip</span> account.
                Click the button below to securely set a new password:
            </p>
            <a href="<%= resetUILink %>" class="btn">Reset Password</a>
            <p>
                If you did not request this change, you can safely ignore this email. This link will expire in
                <strong>10 minutes</strong>.
            </p>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            &copy; <%= new Date().getFullYear() %> FlyTrip. All rights reserved.
        </div>
    </div>
</body>

</html>